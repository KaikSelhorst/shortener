# Copy the relevant section to the appropriate file:
#   api/.env  — Go API
#   web/.env  — SvelteKit frontend

# ── api/.env ─────────────────────────────────────────────────────────────────

PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener

# Generate each with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-char-secret!!
CURSOR_SECRET=srd123axner#lot!54
IP_HASH_SECRET=change-me-to-another-32-char-secret

# ── web/.env ─────────────────────────────────────────────────────────────────

# URL of the Go API — server-side only, never exposed to the browser
API_URL=http://localhost:8080
