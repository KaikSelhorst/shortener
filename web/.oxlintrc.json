{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn"
  },
  "overrides": [
    {
      "files": ["*.svelte"],
      "env": {
        "browser": true
      }
    }
  ],
  "ignorePatterns": ["node_modules", ".svelte-kit", "build", "dist"]
}
